<!DOCTYPE html><html lang="id"><head><!-- PLAYABLE_TOUCH_PATCH_V1 --><script>
(function() {
  if (window.__playableTouchPatchInstalled) return;
  window.__playableTouchPatchInstalled = true;
  var origAdd = EventTarget.prototype.addEventListener;
  var blockedTypes = { touchstart: 1, touchmove: 1, wheel: 1 };
  EventTarget.prototype.addEventListener = function(type, listener, options) {
    if (blockedTypes[type]) {
      if (options === undefined || options === null) {
        options = { passive: true };
      } else if (typeof options === 'boolean') {
        options = { capture: options, passive: true };
      } else {
        options = Object.assign({}, options, { passive: true });
      }
    }
    return origAdd.call(this, type, listener, options);
  };
})();
</script><script>window.Intl=window.Intl||{};Intl.t=function(s){return(Intl._locale&&Intl._locale[s])||s;};</script><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ALWI PUSAT - FIXED</title><link rel="manifest" href="manifest.json"><meta name="theme-color" content="#c9a84c"><style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#000 url('img/alwi_ghost_bug.png') no-repeat center center fixed;background-size:cover;color:#fff;font-family:Arial,sans-serif;min-height:100vh}
body::before{content:"";position:fixed;inset:0;background:rgba(0,0,0,0.72);z-index:0}
.header{position:sticky;top:0;z-index:99998;background:rgba(10,10,10,0.96);padding:12px 16px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(201,168,76,0.35);backdrop-filter:blur(8px)}
.logo{color:#e50914;font-weight:900;font-size:20px;letter-spacing:0.5px}
.btn-live{background:#e50914;color:#fff;padding:8px 14px;border-radius:6px;font-weight:700;text-decoration:none;font-size:13px;box-shadow:0 2px 8px rgba(229,9,20,0.4)}
.nav{position:sticky;top:52px;z-index:99999;display:flex;flex-wrap:wrap;gap:8px;padding:12px 16px;background:rgba(0,0,0,0.96);border-bottom:2px solid #c9a84c}
.drop{position:relative}.drop-btn{background:linear-gradient(180deg,#222,#111);border:2px solid #FFD700;color:#FFD700;padding:9px 16px;border-radius:20px;cursor:pointer;font-weight:700;font-size:13px;box-shadow:0 0 12px rgba(255,215,0,0.25)}
.drop.active .drop-btn{background:#FFD700;color:#000;border-color:#fff}
.drop-content{display:none;position:absolute;top:48px;left:0;min-width:280px;background:linear-gradient(180deg,#2a2a2a,#1a1a1a);border:2px solid #FFD700;border-radius:14px;overflow:hidden;z-index:100000;box-shadow:0 15px 50px rgba(0,0,0,0.95)}
.drop.active .drop-content{display:block;animation:down .18s ease}
@keyframes down{from{opacity:0;transform:translateY(-10px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.drop-content a{display:block;padding:12px 16px;color:#fff;text-decoration:none;font-size:13.5px;border-bottom:1px solid #333}
.drop-content a:hover{background:#FFD700;color:#000}
.mini{font-size:11px;color:#c9a84c;display:block;margin-top:2px}
.hero{position:relative;z-index:1;padding:36px 20px 20px;text-align:center;max-width:700px;margin:0 auto}
.hero h1{color:#FFD700;font-size:28px;margin-bottom:8px;text-shadow:0 2px 12px rgba(0,0,0,0.9)}
.hero p{color:#ddd;font-size:14px;line-height:1.6;text-shadow:0 1px 6px #000}
.badge{display:inline-block;background:rgba(255,215,0,0.15);border:1px solid #FFD700;color:#FFD700;padding:4px 10px;border-radius:20px;font-size:11px;margin-top:8px}
.grid{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:16px;max-width:720px;margin:0 auto}
.card{background:rgba(25,25,25,0.92);border:2px solid rgba(201,168,76,0.5);border-radius:14px;padding:16px;text-align:center;text-decoration:none;color:#fff;transition:.15s}
.card:hover{border-color:#FFD700;background:rgba(255,215,0,0.12);transform:translateY(-2px)}
.card b{font-size:15px}.card span{font-size:11px;color:#FFD700;display:block;margin-top:4px}
.section{position:relative;z-index:1;max-width:720px;margin:18px auto;padding:0 16px}
.section h2{color:#FFD700;font-size:16px;margin:18px 0 10px;border-left:4px solid #FFD700;padding-left:10px}
.list{background:rgba(20,20,20,0.9);border:1px solid #333;border-radius:12px;overflow:hidden}
.list a{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;color:#fff;text-decoration:none;border-bottom:1px solid #2a2a2a;font-size:13.5px}
.list a:hover{background:#222;color:#FFD700}
</style></head><body>
