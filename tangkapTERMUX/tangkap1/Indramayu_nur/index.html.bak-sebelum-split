    function card(f) {
      const badgeClass = (f.cat === 'sholat' || f.cat === 'adzan') ? 'b-sholat' : f.cat === 'live' ? 'b-live' : f.cat === 'bot' ? 'b-bot' : f.path.endsWith('/') ? 'b-folder' : 'b-file';
      return `<a href="${f.path}" class="card">
        <div class="ic">${f.icon}</div>
        <div class="nm">${f.name}</div>
        <div class="desc">${f.desc}</div>
        <span class="badge ${badgeClass}">${f.cat.toUpperCase()}</span>
      </a>`;
    }

    function render() {
      const qEl = document.getElementById('q');
      const q = qEl ? qEl.value.toLowerCase() : '';
      let list = FILES;

      if (filterCat !== 'semua') list = list.filter(f => f.cat === filterCat);
      if (q) list = list.filter(f => f.name.toLowerCase().includes(q) || f.desc.toLowerCase().includes(q));

      const flt = a => (q ? a.filter(f => f.name.toLowerCase().includes(q) || f.desc.toLowerCase().includes(q)) : a);
      document.getElementById('gridMetaPage').innerHTML = flt(META_PAGES).map(card).join('');
      document.getElementById('gridMetaStage').innerHTML = flt(META_STAGE).map(card).join('');
      document.getElementById('gridMetaMedia').innerHTML = flt(META_MEDIA).map(card).join('');
      document.getElementById('gridSheet').innerHTML = list.map(card).join('');
      document.getElementById('count').textContent = list.length + ' item';

      const cats = ['semua', 'sholat', 'adzan', 'live', 'media'];
